# ═══════════════════════════════════════════════════════════════
# .htaccess — mediator.sweti.de
# HUGO · Shared Hosting (Strato)
# Stand: Mai 2026
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# GRUNDEINSTELLUNGEN
# ───────────────────────────────────────────────────────────────

Options -Indexes
RewriteEngine On
RewriteBase /

# ───────────────────────────────────────────────────────────────
# 301-REDIRECTS: KONKRETE ALTE URLS
# Wichtig: Diese Regeln stehen VOR HTTPS / WWW / Trailing Slash,
# damit alte URLs direkt auf die finale Ziel-URL gehen.
# ───────────────────────────────────────────────────────────────

# Blog-Artikel umbenannt
RewriteRule ^post/my-first-post/?$ https://mediator.sweti.de/post/was-ist-mediation-mediator-dresden/ [R=301,L]
RewriteRule ^post/my-second-post/?$ https://mediator.sweti.de/post/wie-arbeitet-der-mediator-dresden/ [R=301,L]

# Testimonials-Seite umbenannt
# Testimonials-Seite - hat nie existiert
RewriteRule ^testimonials/?$ - [G,L]

# Dienstleistungen gelöscht
RewriteRule ^dienstleistungen/?$ https://mediator.sweti.de/angebote/ [R=301,L]

# Duplikat-Aufloesung Konflikt-Vorbereitung (Juli 2026)
RewriteRule ^angebote/konfliktverstehen/?$ /angebote/konfliktklaerung-vorbereiten/ [R=301,L]

# Phantomseite umleiten
RewriteRule ^post/kreationsphase-moeglichkeitsraeume/?$ https://mediator.sweti.de/post/kreationsphase-p3-systemische-mediation/ [R=301,L]

# itsm zu beltschew.de kopiert
RewriteRule ^itsm/?$ https://beltschew.de//services/itsm/ [R=301,L]


# ───────────────────────────────────────────────────────────────
# 301-REDIRECTS: KONSOLIDIERUNG CLUSTER 1–4
# ───────────────────────────────────────────────────────────────

# Cluster 1 - Übergang / Coaching
RewriteRule ^angebote/orientierung-finden/?$ https://mediator.sweti.de/angebote/coaching-in-uebergaengen/ [R=301,L]

# Cluster 2 - Pflege & ältere Eltern
RewriteRule ^angebote/pflege-reflektieren/?$ https://mediator.sweti.de/angebote/mediation-bei-pflege-erbe-uebergang-dresden/ [R=301,L]
RewriteRule ^angebote/elder-mediation/?$ https://mediator.sweti.de/angebote/mediation-bei-pflege-erbe-uebergang-dresden/ [R=301,L]

# Cluster 3 - Familie & Generationen
RewriteRule ^angebote/klarkommen-generationen/?$ https://mediator.sweti.de/angebote/familienkonflikt-generationen-dresden/ [R=301,L]

# Cluster 4 - Karteileiche Pflege-Belastung
RewriteRule ^angebote/ruhe-schaffen/?$ https://mediator.sweti.de/angebote/mediation-bei-pflege-erbe-uebergang-dresden/ [R=301,L]

# ───────────────────────────────────────────────────────────────
# 301-REDIRECTS: B2B-ANGEBOTE
# mediator.sweti.de → beltschew.de
# Strategie: Domain-Trennung
# ───────────────────────────────────────────────────────────────

# Service-Redirects: methodisch exakte Zuordnung
RewriteRule ^angebote/rolle-klaeren/?$ https://beltschew.de/services/mensch-rolle-erwartungen-mre/ [R=301,L]
RewriteRule ^angebote/entscheidungen-ermoeglichen/?$ https://beltschew.de/services/klaerungsraeume-organisation/ [R=301,L]

# Zielgruppen-Redirects: Team-Adressierung
RewriteRule ^angebote/veraenderung-durchdenken/?$ https://beltschew.de/zielgruppen/teams/ [R=301,L]
RewriteRule ^angebote/projektteam-spannung/?$ https://beltschew.de/zielgruppen/teams/ [R=301,L]
RewriteRule ^angebote/zusammenarbeit-klaeren/?$ https://beltschew.de/zielgruppen/teams/ [R=301,L]
RewriteRule ^angebote/vertrauen-aufbauen/?$ https://beltschew.de/zielgruppen/teams/ [R=301,L]
RewriteRule ^angebote/konfliktpraevention-team/?$ https://beltschew.de/zielgruppen/teams/ [R=301,L]

# ───────────────────────────────────────────────────────────────
# HTTPS UND CANONICAL HOST ERZWINGEN
# http → https
# www.mediator.sweti.de → mediator.sweti.de
# Beides in EINER Regel, um unnötige Redirect-Ketten zu vermeiden.
# ───────────────────────────────────────────────────────────────

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^mediator\.sweti\.de$ [NC]
RewriteRule ^ https://mediator.sweti.de%{REQUEST_URI} [R=301,L]

# ───────────────────────────────────────────────────────────────
# TRAILING SLASH ERZWINGEN
# Wichtig für Hugo: /seite → /seite/
# Ausnahme: Dateien mit Endung, z. B. .xml, .jpg, .css, .js
# ───────────────────────────────────────────────────────────────

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$
RewriteRule ^ https://mediator.sweti.de%{REQUEST_URI}/ [R=301,L]

# ───────────────────────────────────────────────────────────────
# FEHLERSEITEN
# ───────────────────────────────────────────────────────────────

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ───────────────────────────────────────────────────────────────
# CACHE-CONTROL
# Statische Assets lange cachen → bessere Core Web Vitals
# ───────────────────────────────────────────────────────────────

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: kurz cachen
  ExpiresByType text/html                  "access plus 1 hour"

  # CSS & JavaScript
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType text/javascript            "access plus 1 year"

  # Bilder
  ExpiresByType image/jpeg                 "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType image/gif                  "access plus 1 year"
  ExpiresByType image/svg+xml              "access plus 1 year"
  ExpiresByType image/x-icon               "access plus 1 year"

  # Fonts
  ExpiresByType font/woff                  "access plus 1 year"
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType application/font-woff      "access plus 1 year"
  ExpiresByType application/font-woff2     "access plus 1 year"

  # XML: Sitemap, RSS
  ExpiresByType application/xml            "access plus 1 day"
  ExpiresByType text/xml                   "access plus 1 day"
</IfModule>

# ───────────────────────────────────────────────────────────────
# KOMPRIMIERUNG GZIP
# ───────────────────────────────────────────────────────────────

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ───────────────────────────────────────────────────────────────
# SICHERHEITS-HEADER
# ───────────────────────────────────────────────────────────────

<IfModule mod_headers.c>
  # Clickjacking verhindern
  Header always set X-Frame-Options "SAMEORIGIN"

  # XSS-Schutz
  Header always set X-XSS-Protection "1; mode=block"

  # MIME-Sniffing verhindern
  Header always set X-Content-Type-Options "nosniff"

  # Referrer-Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS: Browser merkt sich HTTPS für 1 Jahr
  # Nur aktivieren, wenn HTTPS dauerhaft korrekt funktioniert.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Cache-Header für statische Assets
  <FilesMatch "\.(css|js|woff|woff2|jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML kurz cachen
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ───────────────────────────────────────────────────────────────
# DIREKTZUGRIFF AUF SENSIBLE DATEIEN SPERREN
# ───────────────────────────────────────────────────────────────

<FilesMatch "(^\.htaccess|^\.htpasswd|^\.env|config\.toml|hugo\.toml)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ═══════════════════════════════════════════════════════════════
# ENDE .htaccess — mediator.sweti.de
# ═══════════════════════════════════════════════════════════════